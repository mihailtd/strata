.env
.venv/
__pycache__/
*.pyc
.python-version.local
.claude/
# results/ holds two very different things: 3.8 GB of adapter weights (must stay
# out of git) and ~1.9 MB of benchmark JSON that is the actual EVIDENCE behind
# every claim in README.md. The JSON is now tracked -- a repo that documents
# measurements should carry the measurements.
results/*
!results/*.json
!results/benchmarks/
!results/benchmarks/*.json
!results/logs/
!results/logs/*.log
!results/logs/*.json
!results/loss_curves/
results/adapters/
results/**/checkpoints/
.hf_cache/
*.egg-info/
data/**
!data/**/
!data/**/*.jsonl
apps/factory/data/**
!apps/factory/data/**/
!apps/factory/data/**/*.jsonl
# astral/raw/{ruff,ty,uv} are vendored doc source (plain tracked content, no
# nested .git -- this repo has no submodules) -- track them in full, not just
# their .jsonl siblings.
!apps/factory/data/astral/raw/**
mlruns/
mlruns.db
mlartifacts/

# Unsloth JIT-compiled trainer cache and micro-probe run outputs
apps/factory/unsloth_compiled_cache/
apps/factory/outputs_micro_probe/

# throwaway adapters from the loss-curve diagnostic (curves themselves are tracked)
results/loss_curves/adapters/

# Model weights and unpacked layers (must stay out of git)
models/*
!models/**/metadata.json
*.pt
*.safetensors
*.gguf
*.bin
*.vtt
scratch/transcript*.txt
.adapters/
projects/**/.adapters/
node_modules/
**/node_modules
target/
**/target/

# Fetched on demand by apps/runtime-llama/setup.sh (git clone --depth 1 +
# local cmake build) -- not our code, not tracked. This repo has no
# submodules; regenerable third-party checkouts are just gitignored.
apps/runtime-llama/llama.cpp/
.moon/cache/
.moon/docker/
