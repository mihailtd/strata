.env
.venv/
__pycache__/
*.pyc
.python-version.local
# results/ holds two very different things: 3.8 GB of adapter weights (must stay
# out of git) and ~1.9 MB of benchmark JSON that is the actual EVIDENCE behind
# every claim in README.md. The JSON is now tracked -- a repo that documents
# measurements should carry the measurements.
results/*
!results/*.json
# `results/*` excludes the DIRECTORY results/loss_curves, and git cannot re-include
# a file inside an excluded directory -- so the "!results/*.json" above never
# reached the curves and 0 of them were tracked, despite the note below claiming
# otherwise. Un-exclude the directory first, then re-exclude the weights in it.
!results/loss_curves/
results/adapters/
results/**/checkpoints/
.hf_cache/
*.egg-info/
data/**
!data/**/
!data/**/*.jsonl
mlruns/
mlruns.db
mlartifacts/

# throwaway adapters from the loss-curve diagnostic (curves themselves are tracked)
results/loss_curves/adapters/
