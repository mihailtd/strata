        <mxCell id="pEdyFxLo0bLftZ3JngXC-2" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;darkOpacity=0.05;fillColor=#ffe6cc;strokeColor=#d79b00;fillStyle=solid;fontSize=18;direction=west;gradientDirection=north;shadow=1;size=20;pointerEvents=1;" value="&lt;span style=&quot;font-size: 12px;&quot;&gt;🔥 Reversible Expert Folding&lt;/span&gt;" vertex="1">
