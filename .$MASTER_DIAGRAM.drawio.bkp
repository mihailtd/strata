        <mxCell id="EfcTNxSgW_AFl3pymhPJ-38" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;💡A fast traffic switcher that replaces standard slow mathematical steps (like text normalization) with hand-tuned hardware instructions built specifically for AMD graphics cards.&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="305" x="-103.75" y="1150" as="geometry" />
